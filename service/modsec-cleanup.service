#!/usr/bin/env sh
set -eu

RETENTION_DAYS="${MODSEC_AUDIT_RETENTION_DAYS:-30}"
TARGET_DIR="/var/log/modsecurity/audit/storage"

# Size thresholds (optional). Prefer MB; GB is converted if set.
MAX_SIZE_MB="${MODSEC_AUDIT_MAX_SIZE_MB:-0}"
MAX_SIZE_GB="${MODSEC_AUDIT_MAX_SIZE_GB:-0}"
if [ "${MAX_SIZE_MB}" -eq 0 ] && [ "${MAX_SIZE_GB}" -gt 0 ]; then
    MAX_SIZE_MB=$((MAX_SIZE_GB * 1024))
fi

printf "[modsec-cleanup] starting; retention=%s days; max_size_mb=%s; target=%s\n" "$RETENTION_DAYS" "$MAX_SIZE_MB" "$TARGET_DIR"

while true; do
    if [ -d "$TARGET_DIR" ]; then
        # 1) Time-based cleanup: delete items older than RETENTION_DAYS
        find "$TARGET_DIR" -mindepth 1 -mtime +"$RETENTION_DAYS" -print -exec rm -rf {} +
        # Remove now-empty directories (best-effort)
        find "$TARGET_DIR" -type d -empty -print -exec rmdir {} + || true

        # 2) Size-based cleanup: prune oldest entries until under MAX_SIZE_MB
        if [ "${MAX_SIZE_MB}" -gt 0 ]; then
            CURRENT_MB=$(du -sm "$TARGET_DIR" 2>/dev/null | awk '{print $1}')
            if [ -n "${CURRENT_MB}" ] && [ "${CURRENT_MB}" -gt "${MAX_SIZE_MB}" ]; then
                printf "[modsec-cleanup] enforcing size limit: current=%sMB limit=%sMB\n" "$CURRENT_MB" "$MAX_SIZE_MB"
                # Iterate oldest-first at top level under storage
                for item in $(ls -1tr "$TARGET_DIR"); do
                    PATH_ITEM="$TARGET_DIR/$item"
                    if [ -e "$PATH_ITEM" ]; then
                        printf "[modsec-cleanup] deleting oldest: %s\n" "$PATH_ITEM"
                        rm -rf "$PATH_ITEM"
                        CURRENT_MB=$(du -sm "$TARGET_DIR" 2>/dev/null | awk '{print $1}')
                        if [ -n "${CURRENT_MB}" ] && [ "${CURRENT_MB}" -le "${MAX_SIZE_MB}" ]; then
                            printf "[modsec-cleanup] size OK: current=%sMB\n" "$CURRENT_MB"
                            break
                        fi
                    fi
                done
            fi
        fi
    else
        printf "[modsec-cleanup] target directory not found: %s\n" "$TARGET_DIR"
    fi
    # Run daily
    sleep 60
done
